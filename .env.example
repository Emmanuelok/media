# Copy to .env.local (local dev) or set these in your host's env vars (production).

# Anthropic API key that powers the Aurora AI concierge.
# Leave empty to use the built-in offline keyword fallback.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by the concierge.
# Defaults to claude-opus-4-8.
AURORA_AI_MODEL=claude-opus-4-8
