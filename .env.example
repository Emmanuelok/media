# Copy to .env.local (local dev) or set these in your host's env vars (production).

# Anthropic API key that powers the Aurora AI concierge.
# Leave empty to use the built-in offline keyword fallback.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by the concierge.
# Defaults to claude-opus-4-8.
AURORA_AI_MODEL=claude-opus-4-8

# Optional: stream-proxy rate limit (requests/minute per IP). Default 300.
# AURORA_PROXY_RPM=300

# Optional: restrict the stream proxy to specific upstream host suffixes
# (comma-separated). When unset, any public host is allowed.
# AURORA_PROXY_ALLOWED_HOSTS=akamaized.net,cloudfront.net,getaj.net

# --- Optional backend: cross-device sync + background push reminders ---

# Durable key-value store (Upstash Redis / Vercel KV). Required for durable
# cross-device sync and for background push (so registrations survive restarts).
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxxxx

# Web push (background routine reminders). Generate with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=xxxxx
# VAPID_PRIVATE_KEY=xxxxx
# VAPID_SUBJECT=mailto:you@example.com

# Secret that authorizes the cron endpoint (/api/cron/run). On Vercel, set this
# and the included vercel.json cron sends it as a Bearer token automatically.
# CRON_SECRET=some-long-random-string
